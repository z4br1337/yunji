# 云迹生产环境（腾讯云 CVM）示例
# 复制一份为 .env，按实际情况修改后再 docker compose up --build

# Django 安全密钥（生产环境务必替换为随机长字符串）
DJANGO_SECRET_KEY=change-me-to-a-random-long-secret-string

# 超级管理员（首次启动会自动创建/确认）
ADMIN_USERNAME=daoshengzsb0125
ADMIN_PASSWORD=replace-with-a-strong-password

# 密码哈希加盐（与之前保持一致即可兼容旧账号）
PASSWORD_SALT=yunji_salt_2026

# 应用端口（Docker 内部固定 8080，由 nginx 反向代理）
PORT=8080

# 持久化数据目录（Docker 内部固定 /data）
DATA_DIR=/data

# 调试开关（生产建议 False）
DEBUG=False

# 前端静态资源目录（Dockerfile 已编译到 /webapp/dist）
FRONTEND_DIR=/webapp/dist

# 邮件（当前主流程不依赖邮件；如需找回密码/绑定邮箱再改为 smtp 并填 host）
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=45
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
